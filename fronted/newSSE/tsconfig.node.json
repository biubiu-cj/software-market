{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["vite.config.ts", "plugins/**/*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "./node_modules/.tmp/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ESNext"],
    "types": ["node"]
  }
}
