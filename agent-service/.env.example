# 复制为 .env 后按需修改；不要提交真实 Key。
# agent-service 本身不自动读取 .env，请通过 IDE / shell / systemd 注入环境变量。

# 内部调用 Token，必须与主应用 agent.service.token 一致
AGENT_SERVICE_TOKEN=dev-token

# 主应用数据库（只读账号优先）
RAG_DB_URL=jdbc:mysql://localhost:3306/software_market?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
RAG_DB_USERNAME=root
RAG_DB_PASSWORD=

# Kafka
KAFKA_SERVERS=localhost:9092

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=software_market_rag

# 本地 Ollama BGE-M3 Embedding（需先启动 Ollama 并 pull bge-m3）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_DIMENSION=1024

# DeepSeek Chat（未配置时使用检索摘要兜底）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
